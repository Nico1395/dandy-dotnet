<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Online Shop</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <NavMenuItem Href="/" Icon="bi bi-house-door-fill-nav-menu" Name="Home" />
        <NavMenuItem Href="/products" Icon="bi bi-house-door-fill-nav-menu" Name="Shop" />
        <NavMenuItem Href="/products" Icon="bi bi-house-door-fill-nav-menu" Name="My Orders" />

        <hr />

        <NavMenuItem Href="/products" Icon="bi bi-house-door-fill-nav-menu" Name="Products" />
        <NavMenuItem Href="/products" Icon="bi bi-house-door-fill-nav-menu" Name="Inventory" />
        <NavMenuItem Href="/products" Icon="bi bi-house-door-fill-nav-menu" Name="Customer Orders" />
    </nav>
</div>

@code {
    private bool _collapseNavMenu = true;

    private string? NavMenuCssClass => _collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        _collapseNavMenu = !_collapseNavMenu;
    }
}
